# Copy to a location OUTSIDE the repo (e.g. ~/.aisleiq/aisleiq.env) and fill in.
# The wizard (scripts/setup_snowflake.sh) generates this file for you.
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=AISLEIQ_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=/path/outside/repo/aisleiq_rsa_key.p8
SNOWFLAKE_ROLE=AISLEIQ_TRANSFORMER
SNOWFLAKE_WAREHOUSE=AISLEIQ_WH
SNOWFLAKE_DATABASE=AISLEIQ_DEV
